#===============================================================

# Class Node digunakan sebagai struktur dasar dari setiap elemen dalam Tree
class Node:
    def __init__(self, data):
        self.data = data    # Menyimpan nilai atau konten dari node
        self.left = None    # Inisialisasi pointer untuk anak (child) sebelah kiri
        self.right = None   # Inisialisasi pointer untuk anak (child) sebelah kanan

# Membuat objek 'root' sebagai titik awal (akar) dari struktur Tree
root = Node('A')

# Menampilkan isi atau status dari node yang baru dibuat
print("Data pada root        :", root.data)
print("Data child kiri root  :", root.left)
print("Data child kanan root :", root.right)

#===============================================================
# Penjelasan:
#===============================================================
# 1. Class Node berfungsi sebagai 'blueprint' untuk setiap titik di dalam pohon.
# 2. Atribut 'self.data' digunakan untuk menyimpan nilai (dalam kasus ini karakter 'A').
# 3. Atribut 'self.left' dan 'self.right' diatur ke 'None' saat pertama kali dibuat
#    karena node tersebut belum memiliki cabang atau hubungan ke node lainnya.
# 4. 'None' pada output menunjukkan bahwa saat ini root 'A' masih berdiri sendiri 
#    sebagai 'Leaf Node' (node daun) yang tidak memiliki anak.